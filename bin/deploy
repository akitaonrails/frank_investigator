#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
KAMAL="$SCRIPT_DIR/bin/kamal"

# Production deploys use Kamal over SSH to the host in config/deploy.yml.
# Keep this wrapper so muscle-memory commands like `bin/deploy` and
# `bin/deploy status` cannot accidentally hit the old compose/LAN path.
export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -F ~/.ssh/config}"

COMMAND="${1:-deploy}"
if [ "$#" -gt 0 ]; then
  shift
fi

case "$COMMAND" in
  deploy)
    exec "$KAMAL" deploy "$@"
    ;;
  setup)
    exec "$KAMAL" setup "$@"
    ;;
  logs)
    exec "$KAMAL" logs "$@"
    ;;
  worker-logs|worker_logs)
    exec "$KAMAL" worker_logs "$@"
    ;;
  status)
    exec "$KAMAL" app details "$@"
    ;;
  shell)
    exec "$KAMAL" shell "$@"
    ;;
  worker-shell|worker_shell)
    exec "$KAMAL" worker_shell "$@"
    ;;
  console)
    exec "$KAMAL" console "$@"
    ;;
  stop)
    exec "$KAMAL" app stop "$@"
    ;;
  kamal)
    exec "$KAMAL" "$@"
    ;;
  help|-h|--help)
    cat <<'HELP'
Usage: bin/deploy [deploy|setup|logs|worker-logs|status|shell|worker-shell|console|stop]

Kamal-backed production wrapper:
  deploy        Build, push to GHCR, and deploy web + worker (default)
  setup         Run Kamal setup
  logs          Tail web logs
  worker-logs   Tail worker logs
  status        Show Kamal app container status
  shell         Open bash in the running web container
  worker-shell  Open bash in the running worker container
  console       Open Rails console in the web container
  stop          Stop Kamal app containers

Use `bin/deploy kamal ...` or `bin/kamal ...` for any raw Kamal command.
HELP
    ;;
  *)
    exec "$KAMAL" "$COMMAND" "$@"
    ;;
esac
